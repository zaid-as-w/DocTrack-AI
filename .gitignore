# Dependencies
node_modules/
.pnp
.pnp.js

# Production build
dist/
build/

# Environment files & secrets (strictly ignore all .env files)
.env
.env.*
*.env
**/.env*
!**/.env.example
!client/.env.production

# Test & diagnostic scratch scripts (contain local runtime environment configs)
scratch/
server/test_*.js
server/audit_*.js
server/verify_*.js
server/health_check.js
test_*.js
audit_*.js
verify_*.js
health_check.js

# Logs & task artifacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
tasks/
.system_generated/

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local file storage (documents uploaded to DocTrack AI)
server/uploads/*
!server/uploads/.gitkeep

# Local database files (never commit user records or credentials)
server/data/*.json
!server/data/.gitkeep
data/*.json
!data/.gitkeep

# Deployment artifacts
.vercel/
