# =================================================================
# DOCTRACK AI — SERVER ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the values for your environment.
# =================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
CLIENT_URL=https://doc-track-ai.vercel.app

# Database Configuration (Standard MongoDB URI or Atlas connection string)
# Note: For MongoDB Atlas, use standard mongodb+srv:// URI, NOT an Atlas SQL endpoint.
MONGODB_URI=mongodb://localhost:27017/doctrack
DB_NAME=doctrack

# Authentication & Security
# Generate a strong 256-bit random secret in production (e.g. openssl rand -hex 32)
JWT_SECRET=your_production_jwt_secret_key_change_me
JWT_EXPIRES_IN=7d

# Cloudinary Storage (Persistent Cloud Document & Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini AI (LLM Classification, Metadata Extraction & Chatbot)
GEMINI_API_KEY=your_gemini_api_key

# Amazon Simple Email Service (SES) Configuration (AWS SDK v3)
# Note: Verified sender identity in Amazon SES is required in the configured AWS_REGION.
# IAM principal requires least-privilege ses:SendEmail permission.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
SES_FROM_EMAIL="DocTrack AI <notifications@doctrack.ai>"

# Optional External AI / OCR Service URL (e.g. FastAPI service on Render)
AI_SERVICE_URL=

# Twilio SMS & Voice Configuration (Multi-Channel Delivery)
# Priority authentication: Account SID + Auth Token (or API Key + API Secret)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_API_KEY=your_twilio_api_key
TWILIO_API_SECRET=your_twilio_api_secret
# Sender phone number must be a valid Twilio-owned number or verified caller ID in E.164 format (+[country code][number])
TWILIO_PHONE_NUMBER=+1234567890
# Optional Twilio Messaging Service SID (alternative to TWILIO_PHONE_NUMBER)
TWILIO_MESSAGING_SERVICE_SID=
# Optional Twilio status callback webhook URL
TWILIO_STATUS_CALLBACK_URL=

