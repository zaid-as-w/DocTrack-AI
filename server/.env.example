# =================================================================
# DOCTRACK AI — SERVER ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the values for your environment.
# =================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
CLIENT_URL=https://doc-track-ai.vercel.app

# Database Configuration (Standard MongoDB URI or Atlas connection string)
# Note: For MongoDB Atlas, use standard mongodb+srv:// URI, NOT an Atlas SQL endpoint.
MONGODB_URI=mongodb://localhost:27017/doctrack
DB_NAME=doctrack

# Authentication & Security
# Generate a strong 256-bit random secret in production (e.g. openssl rand -hex 32)
JWT_SECRET=your_production_jwt_secret_key_change_me
JWT_EXPIRES_IN=7d

# Cloudinary Storage (Persistent Cloud Document & Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini AI (LLM Classification, Metadata Extraction & Chatbot)
GEMINI_API_KEY=your_gemini_api_key

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
EMAIL_FROM="DocTrack AI <notifications@doctrack.ai>"

# Optional External AI / OCR Service URL (e.g. FastAPI service on Render)
AI_SERVICE_URL=

# Twilio SMS / WhatsApp (Optional Multi-Channel Delivery)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_API_KEY=your_twilio_api_key
TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_PHONE_NUMBER=+1234567890
