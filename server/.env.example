# =================================================================
# DOCTRACK AI — SERVER ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the values for your environment.
# =================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
CLIENT_URL=https://doc-track-ai.vercel.app

# Database Configuration (Standard MongoDB URI or Atlas connection string)
# Note: For MongoDB Atlas, use standard mongodb+srv:// URI, NOT an Atlas SQL endpoint.
MONGODB_URI=mongodb://localhost:27017/doctrack
DB_NAME=doctrack

# Authentication & Security
# Generate a strong 256-bit random secret in production (e.g. openssl rand -hex 32)
JWT_SECRET=your_production_jwt_secret_key_change_me
JWT_EXPIRES_IN=7d

# Cloudinary Storage (Persistent Cloud Document & Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini AI (LLM Classification, Metadata Extraction & Chatbot)
GEMINI_API_KEY=your_gemini_api_key

# Official Google Gmail API Configuration (OAuth2 Authentication)
# The authorized Gmail address that sends transactional emails & OTPs
GMAIL_USER=your-authorized-gmail@gmail.com
# Google Cloud Console OAuth 2.0 Web/Desktop Client Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# OAuth 2.0 Refresh Token obtained via Google OAuth 2.0 Playground
# Using Redirect URI: https://developers.google.com/oauthplayground
# Scope: https://www.googleapis.com/auth/gmail.send
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token

# Optional External AI / OCR Service URL (e.g. FastAPI service on Render)
AI_SERVICE_URL=

# Twilio SMS & Voice Configuration (Multi-Channel Delivery)
# Priority authentication: Account SID + Auth Token (or API Key + API Secret)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_API_KEY=your_twilio_api_key
TWILIO_API_SECRET=your_twilio_api_secret
# Sender phone number must be a valid Twilio-owned number or verified caller ID in E.164 format (+[country code][number])
TWILIO_PHONE_NUMBER=+1234567890
# Optional Twilio Messaging Service SID (alternative to TWILIO_PHONE_NUMBER)
TWILIO_MESSAGING_SERVICE_SID=
# Optional Twilio status callback webhook URL
TWILIO_STATUS_CALLBACK_URL=
